{
  "name": "smart-car-wash",
  "version": "1.0.0",
  "description": "Smart Car Wash - Full-Stack Online Car Wash Booking System (React + Express + MongoDB)",
  "scripts": {
    "dev": "node dev.js",
    "start": "node dev.js",
    "seed": "cd backend && npm run seed",
    "start:backend": "cd backend && npm run dev",
    "start:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build": "npm run build:frontend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "car-wash",
    "booking-system",
    "react",
    "express",
    "mongodb",
    "rest-api"
  ],
  "author": "Smart Car Wash Engineering Team",
  "license": "MIT"
}
